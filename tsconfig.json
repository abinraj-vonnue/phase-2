{
    "compilerOptions": {
        "target": "esnext",
        "module": "es2022",
        "rewriteRelativeImportExtensions": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "types": ["jest", "node"]
    }
}
