generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model assignments {
  id        Int     @id @default(autoincrement())
  ticket_id Int
  user_id   Int
  tickets   tickets @relation(fields: [ticket_id], references: [ticket_id], onDelete: Cascade, onUpdate: NoAction)
  users     users   @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([ticket_id, user_id])
}

model categories {
  category_id Int       @id @default(autoincrement())
  category    String    @unique @db.VarChar(50)
  tickets     tickets[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model comments {
  comment_id  Int        @id @default(autoincrement())
  text        String
  user_id     Int?
  customer_id Int?
  ticket_id   Int
  customers   customers? @relation(fields: [customer_id], references: [customer_id], onDelete: NoAction, onUpdate: NoAction)
  tickets     tickets    @relation(fields: [ticket_id], references: [ticket_id], onDelete: Cascade, onUpdate: NoAction)
  users       users?     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model customers {
  customer_id Int        @id @default(autoincrement())
  name        String     @db.VarChar(50)
  email       String     @unique @db.VarChar(100)
  comments    comments[]
  tickets     tickets[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model status_history {
  status_id       Int       @id @default(autoincrement())
  ticket_id       Int
  previous_status String?   @db.VarChar
  new_status      String    @db.VarChar
  updated_by      Int
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  tickets         tickets   @relation(fields: [ticket_id], references: [ticket_id], onDelete: Cascade, onUpdate: NoAction)
  users           users     @relation(fields: [updated_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tickets {
  ticket_id      Int              @id @default(autoincrement())
  title          String           @db.VarChar(50)
  description    String?
  status         String           @db.VarChar(20)
  priority       String           @db.VarChar(20)
  customer_id    Int
  category_id    Int
  created_at     DateTime?        @default(now()) @db.Timestamp(6)
  assignments    assignments[]
  comments       comments[]
  status_history status_history[]
  categories     categories       @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  customers      customers        @relation(fields: [customer_id], references: [customer_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([ticket_id], map: "i")
  @@index([priority], map: "idx_priority")
}

model users {
  user_id        Int              @id @default(autoincrement())
  name           String           @db.VarChar(50)
  email          String           @unique @db.VarChar(100)
  assignments    assignments[]
  comments       comments[]
  status_history status_history[]
}
